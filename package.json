{
  "name": "playwright-frontend-demo",
  "homepage": "https://softspaceg.github.io/playwright-frontend-demo/",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && cp dist/index.html dist/404.html",
    "preview": "vite preview",
    "deploy": "npm run build && gh-pages -d dist",
    "e2e": "playwright test --config=e2e/playwright.config.ts",
    "e2e:ui": "playwright test --ui --config=e2e/playwright.config.ts",
    "e2e:smoke": "playwright test --config=e2e/playwright.config.ts smoke",
    "e2e:regression": "playwright test --config=e2e/playwright.config.ts regression"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.2.0",
    "typescript": "~5.6.3",
    "vite": "^5.4.11"
  }
}
